// ==================== 页眉页脚设置 ====================

#let with-header-footer(body) = {
  set page(
    header: [
      #grid(
        columns: (auto, 1fr, auto),
        [#align(left)[#text(size: 9pt)[#course-code #system-name #subsystem-name]]],
        [#align(center)[]],
        [#align(right)[#text(size: 9pt, style: "italic")[#subsystem-name]]],
